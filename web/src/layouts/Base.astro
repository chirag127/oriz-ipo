---
interface Props {
  title?: string;
  desc?: string;
}
const { title = 'IPO GMP Terminal — ipo.oriz.in', desc = 'Live India IPO grey-market premium, ranked. Updated hourly.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #07090c;
        --panel: #0d1117;
        --panel-2: #121820;
        --line: #1c2530;
        --ink: #d7e0ea;
        --dim: #6b7986;
        --up: #35f0a0;      /* phosphor green — positive GMP */
        --up-glow: rgba(53, 240, 160, 0.35);
        --down: #ff5c6c;    /* negative */
        --sme: #ffb347;     /* amber — SME tag */
        --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --font-disp: 'Space Grotesk', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

      /* scanline hero — the signature element */
      .hero {
        border-bottom: 1px solid var(--line);
        background:
          repeating-linear-gradient(0deg, transparent 0 3px, rgba(53,240,160,0.02) 3px 4px),
          radial-gradient(120% 140% at 80% -10%, rgba(53,240,160,0.10), transparent 60%);
      }
      .hero-inner { padding: 34px 0 26px; }
      .tag {
        font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase;
        color: var(--up); display: inline-flex; align-items: center; gap: 8px;
      }
      .pulse {
        width: 7px; height: 7px; border-radius: 50%; background: var(--up);
        box-shadow: 0 0 0 0 var(--up-glow); animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 var(--up-glow); }
        70% { box-shadow: 0 0 0 9px transparent; }
        100% { box-shadow: 0 0 0 0 transparent; }
      }
      h1 {
        font-family: var(--font-disp); font-weight: 700;
        font-size: clamp(28px, 5vw, 44px); line-height: 1.05;
        margin: 14px 0 6px; letter-spacing: -0.01em;
      }
      h1 .ticker { color: var(--up); text-shadow: 0 0 18px var(--up-glow); }
      .sub { color: var(--dim); max-width: 60ch; margin: 0; }
      .meta {
        margin-top: 16px; display: flex; gap: 22px; flex-wrap: wrap;
        font-size: 12px; color: var(--dim); letter-spacing: 0.04em;
      }
      .meta b { color: var(--ink); font-weight: 600; }

      /* ledger table */
      .ledger { width: 100%; border-collapse: collapse; margin: 22px 0 40px; font-variant-numeric: tabular-nums; }
      .ledger thead th {
        text-align: left; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--dim); font-weight: 600; padding: 10px 12px; border-bottom: 1px solid var(--line);
      }
      .ledger td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
      .ledger tbody tr:hover { background: var(--panel); }
      .rank { color: var(--dim); width: 34px; }
      .name { font-family: var(--font-disp); font-weight: 500; color: var(--ink); }
      .name small { display: block; color: var(--dim); font-family: var(--font-mono); font-weight: 400; font-size: 11px; margin-top: 2px; }
      .gmp { font-weight: 700; font-size: 16px; text-align: right; width: 92px; }
      .gmp.up { color: var(--up); }
      .gmp.down { color: var(--down); }
      .bar { height: 4px; background: var(--panel-2); border-radius: 2px; overflow: hidden; margin-top: 6px; }
      .bar > i { display: block; height: 100%; background: var(--up); box-shadow: 0 0 8px var(--up-glow); }
      .pill {
        font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px;
        border: 1px solid var(--line); border-radius: 999px; color: var(--dim);
      }
      .pill.sme { color: var(--sme); border-color: rgba(255,179,71,0.4); }
      .stars { color: var(--sme); font-size: 12px; }
      .empty { padding: 60px 12px; text-align: center; color: var(--dim); }

      footer { border-top: 1px solid var(--line); color: var(--dim); font-size: 12px; padding: 22px 0 40px; }
      footer a:hover { color: var(--up); }

      @media (max-width: 640px) {
        .hide-sm { display: none; }
        .ledger td, .ledger thead th { padding: 10px 8px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .pulse { animation: none; }
      }
      :focus-visible { outline: 2px solid var(--up); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
