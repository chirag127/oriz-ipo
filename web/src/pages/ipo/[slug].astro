---
import Base from '../../layouts/Base.astro';
import { loadSnapshot, type Ipo } from '../../lib/data';

export function getStaticPaths() {
  const snap = loadSnapshot();
  return snap.picks
    .filter((p) => p.slug)
    .map((ipo) => ({ params: { slug: ipo.slug }, props: { ipo } }));
}

const { ipo } = Astro.props as { ipo: Ipo };
const pct = ipo.gmp_pct ?? 0;
const sub = (n: number | null) => (n == null ? null : `${n}x`);
---

<Base title={`${ipo.name} — ${pct.toFixed(1)}% GMP`} desc={ipo.summary}>
  <header class="hero">
    <div class="wrap hero-inner">
      <span class="tag"><span class="pulse" aria-hidden="true"></span><a href="/">← Terminal</a></span>
      <h1>{ipo.name}</h1>
      <div class="meta">
        <span>GMP <b style="color:var(--up)">{pct.toFixed(1)}%</b></span>
        {ipo.gmp != null && <span>₹<b>{ipo.gmp}</b></span>}
        {ipo.price_band && <span>band <b>{ipo.price_band}</b></span>}
        {ipo.issue_size && <span>size <b>{ipo.issue_size}</b></span>}
        <span><b>Mainboard</b></span>
        {ipo.status && <span><b>{ipo.status}</b></span>}
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="analysis">
      <h2 class="sec">AI analysis</h2>
      <p class="lede">{ipo.summary || `Grey-market premium ~${pct.toFixed(1)}%. Full analysis updates hourly.`}</p>
    </section>

    {ipo.comment_analysis && (
      <section class="analysis">
        <h2 class="sec">Reviewer consensus</h2>
        <p class="lede">{ipo.comment_analysis}</p>
      </section>
    )}

    {(ipo.sub_total != null || ipo.sub_qib != null) && (
      <section class="analysis">
        <h2 class="sec">Subscription</h2>
        <div class="subgrid">
          {ipo.sub_total != null && <div><span>Overall</span><b>{sub(ipo.sub_total)}</b></div>}
          {ipo.sub_qib != null && <div><span>QIB</span><b>{sub(ipo.sub_qib)}</b></div>}
          {ipo.sub_nii != null && <div><span>NII</span><b>{sub(ipo.sub_nii)}</b></div>}
          {ipo.sub_retail != null && <div><span>Retail</span><b>{sub(ipo.sub_retail)}</b></div>}
        </div>
      </section>
    )}

    <section class="analysis">
      <h2 class="sec">Reviews {ipo.videos.length > 0 && <span class="cnt">{ipo.videos.length}</span>}</h2>
      {ipo.videos.length > 0 ? (
        <table class="ledger">
          <tbody>
            {ipo.videos.map((v) => (
              <tr>
                <td>
                  <a class="name" href={v.url} target="_blank" rel="noopener">{v.title}</a>
                  <small>{v.channel || '—'}</small>
                </td>
                <td class="gmp" style="color:var(--ink)">{v.views ? v.views.toLocaleString() : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="lede" style="color:var(--dim)">No YouTube reviews gathered yet.</p>
      )}
    </section>
  </main>

  <footer>
    <div class="wrap">
      Not investment advice. GMP is an unofficial signal. · <a href="/">Terminal</a> · <a href="/history">History</a>
    </div>
  </footer>

  <style is:global>
    .analysis { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .sec { font-family: var(--font-disp); font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--up); margin: 0 0 10px; }
    .sec .cnt { color: var(--dim); }
    .analysis .lede { margin: 0; color: var(--ink); font-size: 16px; line-height: 1.6; max-width: 68ch; }
    .subgrid { display: flex; gap: 26px; flex-wrap: wrap; }
    .subgrid > div { display: flex; flex-direction: column; }
    .subgrid span { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
    .subgrid b { font-family: var(--font-mono); font-size: 20px; color: var(--up); }
    .name small { display: block; color: var(--dim); font-size: 11px; margin-top: 2px; }
  </style>
</Base>
